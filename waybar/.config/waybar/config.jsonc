{
	"position": "top",
	"margin": "10 10 0 10",
	"reload_style_on_change": true,
	"modules-left": [
		"hyprland/workspaces",
		"hyprland/window"
	],
	"modules-right": [
		"mpris",
		"custom/vpn",
		"custom/recorder",
		"wireplumber",
		"custom/mic",
		"clock#date",
		"clock",
		"tray"
	],
	"privacy": {
		"icon-spacing": 5,
		"icon-size": 13,
		"transition-duration": 250,
		"modules": [
			{
				"type": "screenshare",
				"tooltip": true,
				"tooltip-icon-size": 24
			},
			{
				"type": "audio-in",
				"tooltip": true,
				"tooltip-icon-size": 24
			}
		]
	},
	"mpris": {
		"format": "{player_icon} {dynamic}",
		"format-paused": "{status_icon} <i>{dynamic}</i>",
		"player-icons": {
			"default": "⏸"
		},
		"status-icons": {
			"paused": "▶"
		},
		"dynamic-len": 45,
		"dynamic-order": [
			"title",
			"artist",
			"album"
		]
	},
	"custom/vpn": {
		"format": " VPN",
		"exec": "echo '{\"class\": \"connected\"}'",
		"exec-if": "test -d /proc/sys/net/ipv4/conf/tun0",
		"return-type": "json",
		"interval": 5
	},
	"custom/mic": {
		"format": " {}",
		"exec": "$XDG_CONFIG_HOME/waybar/scripts/mic.sh",
		"hide-empty-text": true,
		"signal": 8
	},
	"custom/recorder": {
		"format": " {}",
		"exec": "$XDG_CONFIG_HOME/waybar/scripts/recording.sh",
		"hide-empty-text": true,
		"signal": 7
	},
	"hyprland/window": {
		"format": "",
		"max-length": 60,
		"icon": false,
		"icon-size": 16
	},
	"tray": {
		"icon-size": 16,
		"spacing": 5
	},
	"clock#date": {
		"interval": 600,
		"format": "{:%a %d}"
	},
	"mpd": {
		"format": " {artist} - {title}",
		"format-disconnected": "",
		"format-stopped": "",
		"format-paused": "",
		"on-click": "mpc toggle"
	},
	"temperature": {
		"thermal-zone": 1,
		"format": "{icon} {temperatureC}°C",
		"format-icons": [
			""
		],
		"interval": 10
	},
	"wireplumber": {
		"format": "{icon} {volume}%",
		"format-muted": "",
		"on-click": "foot -T floating pulsemixer",
		"format-icons": {
			"default": [
				"",
				" "
			]
		}
	}
}
