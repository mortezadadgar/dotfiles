#!/bin/bash 
set -eu

OUT="$HOME/Videos/Recordings"

if [ ! -d "$OUT" ]; then
	mkdir -p "$OUT"
fi

if ! pgrep wf-recorder; then
	wf-recorder --codec hevc_vaapi --device /dev/dri/renderD128 \
		--file "$OUT"/$(date +'recording_%Y-%m-%d-%H%M%S.mp4') &
else 
	pkill --signal SIGINT wf-recorder
fi

# update bar
pkill -RTMIN+7 waybar

