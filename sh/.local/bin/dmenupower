#!/bin/bash
# Description: A simple powermenu with dmenu
# Dependencies: dmenu, slock, elogind
# Shell: Bash
set -eu -o pipefail

select=$(printf " Poweroff\n Restart\n󰍃 Logoff\n Lockscreen\n󰤄 Sleep\nHibernate"| dmenu -i)

case $select in
	" Poweroff")
		systemctl poweroff
		;;
	" Restart")
		systemctl reboot
		;;
	"󰍃 Logoff")
		uwsm stop
		;;
	" Lockscreen")
		loginctl lock-session
		;;
	"󰤄 Sleep")
		systemctl suspend
		;;
	"Hibernate")
		systemctl hibernate
		;;
esac
