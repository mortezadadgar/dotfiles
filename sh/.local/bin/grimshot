#!/bin/bash
# Description: dmenu script to take screenshots
# Shell: Bash
set -eu -o pipefail

# Variables
DIR="$HOME/Pictures/screenshots"
FILE="$DIR/$(date '+%y%m%d-%H%M-%S').png"

select=$(printf "󰩬 selected area (copy)\n󰒆 full screen (copy)\n󰩬 selected area\n󰒆 full screen" | dmenu -l 10 -p "Screenshot which area?")

case $select in
	"󰩬 selected area")
		grim -g "$(hyprwindow)" "$FILE"
		notify-send "grimshot" "Screenshot taken"
		;;
	"󰒆 full screen")
		grim "$FILE"
		notify-send "grimshot" "Screenshot taken"
		;;
	"󰩬 selected area (copy)")
		grim -g "$(hyprwindow)" - | wl-copy -t image/png
		notify-send "grimshot" "Screenshot copied to clipboard"
		;;
	"󰒆 full screen (copy)")
		grim - | wl-copy -t image/png
		notify-send "grimshot" "Screenshot copied to clibboard"
		;;
esac
